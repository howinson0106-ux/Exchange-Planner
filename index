        function filterDay(k) { activeDay = k; renderFilterButtons(); refreshUI(); closeInfoBar(); }
        function filterCategory(k) { activeCategory = k; renderFilterButtons(); refreshUI(); closeInfoBar(); }
        
        function addDay() {
            const trip = getCurrentTrip();
            trip.daysCount++;
            saveDataLocally();
            renderFilterButtons();
        }

