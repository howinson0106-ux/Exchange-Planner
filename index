        function updateRoutePolyline() {
            if (routePolyline) map.removeLayer(routePolyline);
            if (!isRouteVisible) return;
            const coords = getFilteredPlaces().map(i => [i.lat, i.lng]);
            if (coords.length > 1) routePolyline = L.polyline(coords, { color: '#4f46e5', weight: 4, opacity: 0.8, dashArray: '8, 8' }).addTo(map);
