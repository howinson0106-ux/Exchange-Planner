        let map, markers = {}, isAddingMode = false, routePolyline = null, isRouteVisible = true;

        function openTrip(id) {
            currentTripId = id;
            const trip = getCurrentTrip();
            document.getElementById('trip-header-name').innerText = trip.name;
            
            document.getElementById('dashboard-view').classList.add('view-hidden');
            document.getElementById('app-nav').classList.add('view-hidden');
            document.getElementById('map-view').classList.remove('view-hidden');
            
            setTimeout(() => {
                if (!map) initMap();
                map.invalidateSize();
                map.setView([trip.lat, trip.lng], 13, { animate: false });
                
                activeDay = 'all'; activeCategory = 'all';
                renderFilterButtons();
                refreshUI(); 
            }, 200);
        }

        function initMap() {
            map = L.map('map', { zoomControl: false });
            L.control.zoom({ position: 'bottomright' }).addTo(map); 
            L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', { 
                maxZoom: 19,
                attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
            }).addTo(map);
            
            map.on('click', function(e) {
                if (!isAddingMode) return;
                openModalWithCoords(e.latlng.lat, e.latlng.lng);
            });
        }

        function refreshUI() {
            renderTimelineList();
            renderMapMarkers();
            if (isRouteVisible) updateRoutePolyline();
            document.getElementById('header-count').innerText = getFilteredPlaces().length;
            document.getElementById('item-count').innerText = getFilteredPlaces().length;
        }

        function getFilteredPlaces() {
            let places = getCurrentPlaces();
            if (activeDay !== 'all') places = places.filter(i => i.day === activeDay);
            if (activeCategory !== 'all') places = places.filter(i => i.category === activeCategory);
            return places;
        }

        async function searchLocationOnMap() {
            const input = document.getElementById('map-search-input');
            const q = input.value.trim();
            if(!q) return;
            
            const btn = input.nextElementSibling;
            btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i>';
            try {
                const res = await fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(q)}`);
                const data = await res.json();
                if(data && data.length > 0) {
                    map.flyTo([parseFloat(data[0].lat), parseFloat(data[0].lon)], 14);
                } else {
                    alert(dict[currentLang].alertLocNotFound);
                }
            } catch(e) { 
                console.error(e); 
                alert(dict[currentLang].alertSearchErr);
            }
            btn.innerHTML = '<i class="fa-solid fa-location-arrow"></i>';
        }

        function renderFilterButtons() {
            const trip = getCurrentTrip();
            const d = dict[currentLang];
            let daysHtml = `<button onclick="filterDay('all')" class="px-4 py-2 rounded-xl text-xs font-bold transition-all ${activeDay === 'all' ? 'bg-slate-900 text-white shadow-md' : 'bg-white text-slate-600 border border-slate-200 hover:bg-slate-100'}">${currentLang === 'zh' ? '全部' : 'All'}</button>`;
            
            for(let i=1; i<=trip.daysCount; i++) {
                const k = 'day' + i;
                const active = activeDay === k;
                daysHtml += `<button onclick="filterDay('${k}')" class="px-4 py-2 rounded-xl text-xs font-bold transition-all ${active ? 'bg-slate-900 text-white shadow-md' : 'bg-white text-slate-600 border border-slate-200 hover:bg-slate-100'}">Day ${i}</button>`;
            }
            daysHtml += `<button onclick="addDay()" class="px-3 py-2 rounded-xl text-xs font-bold transition-all bg-indigo-50 text-indigo-600 border border-indigo-200 hover:bg-indigo-100 hover:scale-105" title="Add Day"><i class="fa-solid fa-plus"></i></button>`;
            
            document.getElementById('day-buttons').innerHTML = daysHtml;

