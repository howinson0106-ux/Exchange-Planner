                        <span id="slide-time" class="text-xs text-slate-300 font-bold bg-white/10 px-2 py-0.5 rounded"><i class="fa-regular fa-clock"></i> 00:00</span>
                    </div>
                    <h2 id="slide-name" class="text-2xl font-bold leading-tight mb-2 text-white drop-shadow-md">Node Name</h2>
                    <p id="slide-desc" class="text-sm text-slate-300 line-clamp-2 leading-relaxed">Description goes here...</p>
                </div>
                <div class="flex flex-col gap-2 shrink-0 border-l border-white/10 pl-4">
                    <button onclick="exitSlideshow()" class="w-10 h-10 rounded-full bg-red-500/20 text-red-400 hover:bg-red-500 hover:text-white transition flex items-center justify-center tooltip" title="Exit">
                        <i class="fa-solid fa-xmark"></i>
                    </button>
                    <button onclick="prevSlide()" class="w-10 h-10 rounded-full bg-white/10 text-white hover:bg-white/20 transition flex items-center justify-center">
                        <i class="fa-solid fa-chevron-up"></i>
                    </button>
                    <button onclick="nextSlide()" class="w-10 h-10 rounded-full bg-white/10 text-white hover:bg-white/20 transition flex items-center justify-center">
                        <i class="fa-solid fa-chevron-down"></i>
                    </button>
                </div>
            </div>
        </main>
    </div>

    <!-- Readonly Modal for Trip Info -->
    <div id="ro-info-modal" class="fixed inset-0 z-[4000] slide-hidden glass-panel flex items-center justify-center p-4 transition-opacity">
        <div class="bg-slate-900 border border-white/20 rounded-3xl shadow-2xl w-full max-w-lg overflow-hidden flex flex-col max-h-[90vh]">
            <div class="px-6 py-5 flex justify-between items-center text-white border-b border-white/10 shrink-0">
                <h3 class="font-bold text-xl flex items-center gap-2 text-indigo-300"><i class="fa-solid fa-clipboard-list"></i> 專案清單與資訊</h3>
                <button onclick="closeReadonlyInfo()" class="w-8 h-8 rounded-full bg-white/10 hover:bg-white/20 flex items-center justify-center transition text-white"><i class="fa-solid fa-xmark"></i></button>
            </div>
            <div class="p-6 overflow-y-auto space-y-6 flex-1 text-slate-300">
                <div>
                    <h4 class="text-xs font-bold text-indigo-400 mb-2 uppercase tracking-wider"><i class="fa-regular fa-clock"></i> 集合時間 / Gather Time</h4>
                    <div class="bg-white/5 px-4 py-3 rounded-xl border border-white/5 font-bold text-white" id="ro-gather-time">未設置</div>
                </div>
                <div>
                    <h4 class="text-xs font-bold text-indigo-400 mb-2 uppercase tracking-wider"><i class="fa-solid fa-suitcase-rolling"></i> 應帶物品 / Checklist</h4>
                    <div class="space-y-2" id="ro-checklist">
                        <!-- Filled by JS -->
                    </div>
                </div>
                <div>
                    <h4 class="text-xs font-bold text-indigo-400 mb-2 uppercase tracking-wider"><i class="fa-solid fa-circle-exclamation"></i> 注意事項 / Notes</h4>
                    <div class="bg-white/5 px-4 py-3 rounded-xl border border-white/5 text-sm whitespace-pre-wrap leading-relaxed text-slate-200" id="ro-notes">無注意事項</div>
                </div>
            </div>
        </div>
    </div>
    
    <script>
        const tripData = ${tripDataJson};
        const catInfo = ${catInfoJson};
        const placeholderImages = ${placeholdersJson};
        
        // Populate Readonly Info Modal
        document.getElementById('ro-gather-time').innerText = tripData.details?.gatherTime || '未設置 (Not set)';
        document.getElementById('ro-notes').innerText = tripData.details?.notes || '無注意事項 (None)';
        const cl = tripData.details?.checklist;
        if(cl && cl.length > 0) {
            document.getElementById('ro-checklist').innerHTML = cl.map(item => '<div class="flex items-center gap-3 bg-white/5 px-4 py-2.5 rounded-xl border border-white/5 text-white"><i class="fa-solid fa-check text-emerald-400"></i> <span class="text-sm font-medium">' + item + '</span></div>').join('');
        } else {
            document.getElementById('ro-checklist').innerHTML = '<div class="text-sm text-slate-500 italic">無項目 (No items)</div>';
        }
        
        function openReadonlyInfo() { document.getElementById('ro-info-modal').classList.remove('slide-hidden'); }
        function closeReadonlyInfo() { document.getElementById('ro-info-modal').classList.add('slide-hidden'); }

        let map = L.map('map', {zoomControl: false});
        L.control.zoom({ position: 'topright' }).addTo(map);
        // Using CartoDB Dark Matter for a more cinematic Earth feel in presentation
        L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png', { maxZoom: 19, attribution: '&copy; OpenStreetMap &copy; CARTO' }).addTo(map);
        map.setView([tripData.lat, tripData.lng], 13);
        
        let html = '';
        let routeCoords = [];
        let markerObjects = [];
        
        tripData.places.forEach((item, idx) => {
            const cat = catInfo[item.category] || catInfo.landmark;
            const img = item.customImage || placeholderImages[item.name.length % placeholderImages.length];
            const dayNum = item.day.replace('day', '');
            routeCoords.push([item.lat, item.lng]);
            
            html += '<div class="bg-white rounded-xl border border-slate-200 overflow-hidden shadow-sm cursor-pointer group mb-5" onclick="goToSlide(' + idx + ')">' +
                '<div class="bg-[#1a1f2c] text-white px-4 py-2.5 flex justify-between items-center">' +
                    '<div class="flex items-center gap-2 text-rose-400 font-bold text-sm tracking-wide"><i class="fa-solid fa-clock"></i> ' + item.time + '</div>' +
                    '<div class="bg-white/15 text-white/90 px-2.5 py-1 rounded text-xs font-medium tracking-wider">Day ' + dayNum + '</div>' +
                '</div>' +
                '<div class="relative w-full h-40 bg-slate-200 overflow-hidden">' +
                    '<img src="' + img + '" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700">' +
                    '<div class="absolute top-3 left-3 bg-[#1a1f2c]/80 backdrop-blur-md text-white px-3 py-1.5 rounded text-xs font-bold flex items-center gap-2 shadow-md">' +
                        '<i class="fa-solid ' + cat.icon + '"></i> ' + cat.name + 
                    '</div>' +
                '</div>' +
                '<div class="p-5 pb-4">' +
                    '<h3 class="text-xl font-bold text-slate-800 mb-2.5 leading-tight group-hover:text-indigo-700 transition">' + item.name + '</h3>' +
                '</div>' +
            '</div>';

            let iconHtml = '';
            if (item.customImage) {
                iconHtml = '<div class="custom-marker w-14 h-14 border-[3px] border-white" style="background-image: url(\\'' + item.customImage + '\\');"><div class="absolute -bottom-1 -right-1 w-6 h-6 rounded-full ' + cat.color + ' border-2 border-white flex items-center justify-center text-[10px] text-white"><i class="fa-solid ' + cat.icon + '"></i></div></div>';
            } else {
                iconHtml = '<div class="custom-marker ' + cat.color + ' w-12 h-12 text-[18px]"><i class="fa-solid ' + cat.icon + '"></i></div>';
            }

            const customIcon = L.divIcon({ className: 'custom-div-icon marker-node-' + idx, html: iconHtml, iconSize: [56, 56], iconAnchor: [28, 28] });
            const marker = L.marker([item.lat, item.lng], { icon: customIcon }).addTo(map);
            markerObjects.push(marker);
        });
        
        document.getElementById('timeline').innerHTML = html || '<div class="text-center py-20 text-slate-400 font-bold">No nodes available.</div>';
        if(routeCoords.length > 1) { L.polyline(routeCoords, { color: '#4f46e5', weight: 4, opacity: 0.8, dashArray: '8, 8' }).addTo(map); }

        // Slideshow Logic
        let currentSlide = -1;
        let isSlideshowActive = false;

        function startSlideshow() {
            if(tripData.places.length === 0) return;
            isSlideshowActive = true;
            document.getElementById('slideshow-overlay').classList.remove('slide-hidden');
            
            // HIDE SIDEBAR & expand map
            document.getElementById('sidebar-panel').style.display = 'none';
            document.getElementById('map-main').classList.remove('hidden');
            
            setTimeout(() => { map.invalidateSize(); }, 300);
            goToSlide(0);
        }

        function exitSlideshow() {
            isSlideshowActive = false;
            document.getElementById('slideshow-overlay').classList.add('slide-hidden');
            
            // SHOW SIDEBAR & restore map layout
            document.getElementById('sidebar-panel').style.display = 'flex';
            if (window.innerWidth < 768) {
                document.getElementById('map-main').classList.add('hidden');
            }
            
            setTimeout(() => { 
                map.invalidateSize(); 
                map.setView([tripData.lat, tripData.lng], 13);
            }, 300);
        }

        function goToSlide(index) {
            if(index < 0) index = tripData.places.length - 1;
            if(index >= tripData.places.length) index = 0;
            currentSlide = index;

            const item = tripData.places[currentSlide];
            const cat = catInfo[item.category] || catInfo.landmark;
            const img = item.customImage || placeholderImages[item.name.length % placeholderImages.length];

            // Update Overlay UI
            document.getElementById('slide-img').src = img;
            document.getElementById('slide-name').innerText = item.name;
            document.getElementById('slide-cat').innerHTML = '<i class="fa-solid ' + cat.icon + '"></i> ' + cat.name;
            document.getElementById('slide-time').innerHTML = '<i class="fa-regular fa-clock"></i> ' + item.time;
            document.getElementById('slide-desc').innerText = item.description || 'No description.';

            // Fly to location smoothly (Earth-like feel)
            map.flyTo([item.lat, item.lng], 16, { animate: true, duration: 1.5 });

            // Ensure overlay is visible if triggered from sidebar click
            if(!isSlideshowActive) {
                isSlideshowActive = true;
                document.getElementById('slideshow-overlay').classList.remove('slide-hidden');
            }
        }

        function nextSlide() { goToSlide(currentSlide + 1); }
        function prevSlide() { goToSlide(currentSlide - 1); }

    <\/script>
</body>
</html>`;

            const blob = new Blob([htmlContent], { type: 'text/html' });
            const a = document.createElement('a');
            a.href = URL.createObjectURL(blob);
            a.download = `DAB_Export_Slide_\${trip.name.replace(/\s+/g, '_')}.html`;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            
            const btn = e.currentTarget;
            const originalHTML = btn.innerHTML;
            btn.innerHTML = '<i class="fa-solid fa-check text-indigo-700"></i> ' + d.msgExportSuccess;
            setTimeout(() => { btn.innerHTML = originalHTML; }, 2000);
        }

        function enableAddMode() {
            isAddingMode = true;
            document.getElementById('map').classList.add('map-crosshair');
            document.getElementById('add-toast').classList.remove('view-hidden');
            if(window.innerWidth < 768) toggleMobileSidebar(); 
        }

        function cancelAddMode() {
            isAddingMode = false;
            document.getElementById('map').classList.remove('map-crosshair');
            document.getElementById('add-toast').classList.add('view-hidden');
        }

        function openModalWithCoords(lat, lng) {
            cancelAddMode();
            document.getElementById('m-lat').value = lat;
            document.getElementById('m-lng').value = lng;
            
            const trip = getCurrentTrip();
            const daySelect = document.getElementById('m-day');
            daySelect.innerHTML = '';
            for(let i=1; i<=trip.daysCount; i++) {
                daySelect.innerHTML += `<option value="day${i}">Day ${i}</option>`;
            }

            if(activeDay !== 'all') document.getElementById('m-day').value = activeDay;
            if(activeCategory !== 'all') document.getElementById('m-cat').value = activeCategory;
            
            document.getElementById('add-modal').classList.remove('view-hidden');
            document.getElementById('m-img-base64').value = ''; 
        }

        function closeModal() {
            document.getElementById('add-modal').classList.add('view-hidden');
            document.querySelector('#add-modal form').reset();
        }

        document.getElementById('m-local-img').addEventListener('change', function(e) {
            const file = e.target.files[0];
            if(!file) return;
            
            const reader = new FileReader();
            reader.onload = function(event) {
                const img = new Image();
                img.onload = function() {
                    const canvas = document.createElement('canvas');
                    const MAX_WIDTH = 400; 
                    const MAX_HEIGHT = 400;
                    let width = img.width, height = img.height;

                    if (width > height) {
                        if (width > MAX_WIDTH) { height *= MAX_WIDTH / width; width = MAX_WIDTH; }
                    } else {
                        if (height > MAX_HEIGHT) { width *= MAX_HEIGHT / height; height = MAX_HEIGHT; }
                    }
                    canvas.width = width; canvas.height = height;
                    const ctx = canvas.getContext('2d');
                    ctx.drawImage(img, 0, 0, width, height);
                    
                    document.getElementById('m-img-base64').value = canvas.toDataURL('image/jpeg', 0.7);
                };
                img.src = event.target.result;
            };
            reader.readAsDataURL(file);
        });

        function saveNewPlace(e) {
            e.preventDefault();
            const newPlace = {
                id: 'place_' + Date.now(),
                name: document.getElementById('m-name').value,
                time: document.getElementById('m-time').value,
                day: document.getElementById('m-day').value,
                category: document.getElementById('m-cat').value,
                customImage: document.getElementById('m-img-base64').value,
                link: document.getElementById('m-link').value,
                description: document.getElementById('m-desc').value,
                lat: parseFloat(document.getElementById('m-lat').value),
                lng: parseFloat(document.getElementById('m-lng').value)
            };

            const trip = getCurrentTrip();
            trip.places.push(newPlace);
            trip.places.sort((a, b) => a.day === b.day ? a.time.localeCompare(b.time) : a.day.localeCompare(b.day));

            saveDataLocally();
            closeModal();
            refreshUI();
            map.flyTo([newPlace.lat, newPlace.lng], 15);
        }

        function toggleDesktopSidebar() { 
            const sb = document.getElementById('sidebar');
            sb.style.display = sb.style.display === 'none' ? 'flex' : 'none';
            setTimeout(() => { if(map) map.invalidateSize(); }, 150);
        }

        function openCreateTripModal() { document.getElementById('create-trip-modal').classList.remove('view-hidden'); }
        function closeCreateTripModal() { document.getElementById('create-trip-modal').classList.add('view-hidden'); document.querySelector('#create-trip-modal form').reset(); }
        
        async function submitNewTrip(e) {
            e.preventDefault();
            const name = document.getElementById('nt-name').value, loc = document.getElementById('nt-loc').value, btn = document.getElementById('create-trip-btn');
            const d = dict[currentLang];
            btn.innerHTML = '<i class="fa-solid fa-circle-notch fa-spin"></i>...'; btn.disabled = true;
            try {
                const res = await fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(loc)}`);
                const data = await res.json();
                if (!data || data.length === 0) throw new Error(d.alertLocNotFound);
                
                tripsData.push({ 
                    id: 'trip_' + Date.now(), 
                    name: name, 
                    location: loc, 
                    lat: parseFloat(data[0].lat), 
                    lng: parseFloat(data[0].lon), 
                    daysCount: 3, 
                    details: { gatherTime: '', checklist: [], notes: '' },
                    places: [] 
                });
                
                saveDataLocally(); closeCreateTripModal(); renderDashboard();
            } catch (err) { alert('Error: ' + err.message); } finally { btn.innerHTML = `<span id="btn-create">${d.btnCreate}</span>`; btn.disabled = false; }
        }

        function deletePlace(id, e) {
            if(e) e.stopPropagation();
            if(confirm(dict[currentLang].alertDeleteNode)) {
                const trip = getCurrentTrip();
                trip.places = trip.places.filter(item => item.id !== id);
                saveDataLocally(); refreshUI(); closeInfoBar(); 
            }
        }
        function deleteCurrentHoverPlace() { if (currentHoverPlaceId) deletePlace(currentHoverPlaceId, null); }
    </script>
</body>
