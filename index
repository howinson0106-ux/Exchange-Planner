                btn.innerHTML = `<i class="fa-solid fa-eye-slash"></i> <span id="btn-hide">${d.btnHide}</span>`;
            } else {
                if (routePolyline) map.removeLayer(routePolyline);
                btn.className = 'text-xs bg-white text-indigo-600 border border-indigo-200 hover:bg-indigo-50 font-semibold px-3 py-1.5 rounded-lg transition flex items-center gap-1 shadow-sm';
