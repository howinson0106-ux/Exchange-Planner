            getFilteredPlaces().forEach(item => {
                const cat = categories[item.category] || categories.landmark;
                let iconHtml = '';
                
                if (item.customImage) {
                    iconHtml = `<div class="custom-marker w-14 h-14 border-[3px] border-white" style="background-image: url('${item.customImage}'); border-color: ${getComputedStyle(document.documentElement).getPropertyValue('--tw-ring-color') || 'white'};">
